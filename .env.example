# このファイルを .env にコピーして値を設定してください
#   cp .env.example .env

# --- LINE Messaging API（必須） ---
# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# --- LiteLLM（必須） ---
# LiteLLM プロキシの URL
LITELLM_BASE_URL=http://localhost:4001
# LiteLLM の API キー（マスターキーまたはバーチャルキー）
LITELLM_KEY=

# --- Valkey（任意） ---
# Webhook の再送による二重返答を防ぐために使用します
# 未設定の場合は重複チェックを行いません
VALKEY_URL=redis://localhost:6379
